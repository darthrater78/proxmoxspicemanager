<Window x:Class="ProxmoxSpiceManager.Dialogs.CreateSnapshotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Snapshot" Height="280" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource ThemeBase}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="3" Background="{DynamicResource ThemeGreen}"/>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom"
                    HorizontalAlignment="Right" Margin="20,0,20,16">
            <Button Content="  Create  " IsDefault="True" Click="OnCreate"
                    Background="{DynamicResource ThemeGreen}" Foreground="{DynamicResource ThemeCrust}"
                    FontWeight="Bold" Padding="16,5" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0"
                    Background="{DynamicResource ThemeSurface1}" Foreground="{DynamicResource ThemeText}"
                    Padding="16,5" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <StackPanel Margin="20,16,20,8">
            <TextBlock Text="SNAPSHOT NAME" Foreground="{DynamicResource ThemeSubtext0}" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Background="{DynamicResource ThemeSurface0}"
                     Foreground="{DynamicResource ThemeText}" CaretBrush="{DynamicResource ThemeText}"
                     BorderBrush="{DynamicResource ThemeSurface1}" Padding="8,6"
                     FontFamily="Consolas" FontSize="12" Margin="0,0,0,12"/>

            <TextBlock Text="DESCRIPTION (optional)" Foreground="{DynamicResource ThemeSubtext0}" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="DescBox" Background="{DynamicResource ThemeSurface0}"
                     Foreground="{DynamicResource ThemeText}" CaretBrush="{DynamicResource ThemeText}"
                     BorderBrush="{DynamicResource ThemeSurface1}" Padding="8,6"
                     FontFamily="Consolas" FontSize="12" Margin="0,0,0,12"/>

            <CheckBox x:Name="RamCheck" Content="Include RAM (VM state)"
                      Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8"/>
        </StackPanel>
    </DockPanel>
</Window>
