<Window x:Class="ProxmoxSpiceManager.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Authenticate" Height="200" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource ThemeBase}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="3" Background="{DynamicResource ThemeYellow}"/>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom"
                    HorizontalAlignment="Right" Margin="24,0,24,16">
            <Button Content="  Connect  " IsDefault="True" Click="OnConnect"
                    Background="{DynamicResource ThemeBlue}" Foreground="{DynamicResource ThemeCrust}"
                    FontWeight="Bold" Padding="16,5" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0"
                    Background="{DynamicResource ThemeSurface1}" Foreground="{DynamicResource ThemeText}"
                    Padding="16,5" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <StackPanel Margin="24,16,24,8">
            <TextBlock x:Name="UserLabel" Foreground="{DynamicResource ThemeText}" FontSize="12"/>
            <TextBlock x:Name="HostLabel" Foreground="{DynamicResource ThemeOverlay0}" FontSize="11" Margin="0,2,0,10"/>
            <PasswordBox x:Name="PasswordBox" Background="{DynamicResource ThemeSurface0}"
                         Foreground="{DynamicResource ThemeText}" CaretBrush="{DynamicResource ThemeText}"
                         BorderBrush="{DynamicResource ThemeSurface1}" Padding="8,6"
                         FontFamily="Consolas" FontSize="12"/>
        </StackPanel>
    </DockPanel>
</Window>
