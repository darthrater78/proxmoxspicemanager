<Window x:Class="ProxmoxSpiceManager.Dialogs.SnapshotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapshots" Height="480" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource ThemeBase}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="3" Background="{DynamicResource ThemeLavender}"/>

        <!-- Bottom buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="20,0,20,16">
            <Button DockPanel.Dock="Right" Content="  Close  " IsCancel="True"
                    Background="{DynamicResource ThemeSurface1}" Foreground="{DynamicResource ThemeText}"
                    Padding="16,6" BorderThickness="0" Cursor="Hand"/>
            <Button DockPanel.Dock="Right" Content="  Rollback  " Click="OnRollback" Margin="0,0,8,0"
                    Background="{DynamicResource ThemePeach}" Foreground="{DynamicResource ThemeCrust}"
                    FontWeight="Bold" Padding="16,6" BorderThickness="0" Cursor="Hand"/>
            <Button DockPanel.Dock="Right" Content="  Delete  " Click="OnDelete" Margin="0,0,8,0"
                    Foreground="{DynamicResource ThemeRed}"
                    Background="{DynamicResource ThemeSurface0}"
                    Padding="16,6" BorderThickness="0" Cursor="Hand"/>
            <Button Content="  + Create  " Click="OnCreate"
                    Foreground="{DynamicResource ThemeGreen}"
                    Background="{DynamicResource ThemeSurface0}"
                    Padding="16,6" BorderThickness="0" Cursor="Hand"/>
        </DockPanel>

        <StackPanel Margin="20,16,20,8">
            <!-- Header -->
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="↻ Refresh" Click="OnRefreshSnaps"
                        Background="{DynamicResource ThemeSurface0}" Foreground="{DynamicResource ThemeSubtext0}"
                        Padding="10,3" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                <TextBlock x:Name="SnapHeader" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource ThemeText}"/>
            </DockPanel>

            <!-- Snapshot list -->
            <DataGrid x:Name="SnapGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" Height="280"
                      Background="{DynamicResource ThemeSurface0}"
                      Foreground="{DynamicResource ThemeText}"
                      BorderThickness="0" GridLinesVisibility="None"
                      RowHeight="28" HeadersVisibility="Column"
                      FontFamily="Segoe UI" FontSize="12">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource ThemeSurface1}"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeSubtext0}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{DynamicResource ThemeSurface0}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurface1}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurface1}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeBlue}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name}" Header="NAME" Width="160"/>
                    <DataGridTextColumn Binding="{Binding Date}" Header="DATE" Width="160"/>
                    <DataGridTextColumn Binding="{Binding Description}" Header="DESCRIPTION" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="SnapStatus" Foreground="{DynamicResource ThemeOverlay0}"
                       FontSize="11" Margin="0,8,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
