<Window x:Class="ProxmoxSpiceManager.Dialogs.ManageNotesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Note Options" Height="400" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource ThemeBase}">

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="SAVED NOTE OPTIONS"
                   Foreground="{DynamicResource ThemeSubtext0}"
                   FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="  Add  " Click="OnAdd"
                        Background="{DynamicResource ThemeBlue}" Foreground="{DynamicResource ThemeCrust}"
                        FontWeight="Bold" Padding="12,4" BorderThickness="0" Cursor="Hand"
                        Margin="8,0,0,0"/>
                <TextBox x:Name="NewOptionBox"
                         Background="{DynamicResource ThemeSurface0}"
                         Foreground="{DynamicResource ThemeText}"
                         CaretBrush="{DynamicResource ThemeText}"
                         BorderBrush="{DynamicResource ThemeSurface1}"
                         BorderThickness="1" Padding="8,4" FontSize="12"
                         KeyDown="OnNewOptionKeyDown"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Delete Selected" Click="OnDelete"
                        Background="{DynamicResource ThemeRed}" Foreground="{DynamicResource ThemeCrust}"
                        Padding="12,4" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
                <Button Content="  Close  " Click="OnClose" IsCancel="True"
                        Background="{DynamicResource ThemeSurface1}" Foreground="{DynamicResource ThemeText}"
                        Padding="12,4" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="OptionsList"
                 Background="{DynamicResource ThemeSurface0}"
                 Foreground="{DynamicResource ThemeText}"
                 BorderBrush="{DynamicResource ThemeSurface1}"
                 BorderThickness="1" FontSize="12"/>
    </DockPanel>
</Window>
