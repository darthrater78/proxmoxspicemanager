<Window x:Class="ProxmoxSpiceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proxmox SPICE Manager v1.1.2" Height="640" Width="1100"
        MinHeight="500" MinWidth="900"
        Background="{DynamicResource ThemeBase}"
        Icon="..\icon.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ThemedComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface0}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurface2}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurface1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface0}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSubtext0}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurface1}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurface2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{DynamicResource ThemeGreen}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeCrust}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeTeal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <Style x:Key="ClusterItem" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface0}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeCrust}">
            <DockPanel Margin="16,0">
                <!-- Right side buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ShortcutBtn" Content="Create Shortcut" Style="{StaticResource FlatButton}"
                            Background="{DynamicResource ThemeCrust}" FontSize="11"
                            Click="OnCreateShortcut" Margin="0,0,4,0"/>
                    <Button x:Name="PrereqBtn" Content="Check Prerequisites" Style="{StaticResource FlatButton}"
                            Background="{DynamicResource ThemeCrust}" FontSize="11"
                            Click="OnCheckPrereqs" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ThemeCombo" Width="160" VerticalAlignment="Center"
                              SelectionChanged="OnThemeChanged"/>
                </StackPanel>

                <!-- Title + links -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◈" Foreground="{DynamicResource ThemeMauve}"
                               FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TitleText" Text="Proxmox SPICE Manager v1.1.2"
                               Foreground="{DynamicResource ThemeText}"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center">
                        <Hyperlink x:Name="GitHubLink" Click="OnGitHubClick"
                                   Foreground="{DynamicResource ThemeBlue}" TextDecorations="Underline">
                            GitHub
                        </Hyperlink>
                        <Run Text=" · " Foreground="{DynamicResource ThemeOverlay0}"/>
                        <Hyperlink x:Name="ReleaseLink" Click="OnReleaseNotesClick"
                                   Foreground="{DynamicResource ThemeBlue}" TextDecorations="Underline">
                            Release Notes
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Accent bar -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeMauve}"/>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeMantle}">
                <DockPanel>
                    <!-- Bottom buttons -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Import" Style="{StaticResource SidebarButton}"
                                    Click="OnImport" HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                            <Button Content="Export" Style="{StaticResource SidebarButton}"
                                    Click="OnExport"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource ThemeSurface0}" Margin="4,0,4,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button Content="+ Add" Style="{StaticResource SidebarButton}"
                                    Click="OnAddCluster" Margin="0,0,4,0"/>
                            <Button Content="Edit" Style="{StaticResource SidebarButton}"
                                    Click="OnEditCluster" Margin="0,0,4,0"/>
                            <Button x:Name="RemoveBtn" Content="Remove" Style="{StaticResource SidebarButton}"
                                    Click="OnRemoveCluster"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Cluster list -->
                    <StackPanel>
                        <TextBlock Text="CLUSTERS" Foreground="{DynamicResource ThemeOverlay0}"
                                   FontSize="10" FontWeight="Bold" Margin="14,14,14,6"/>
                        <Border Height="1" Background="{DynamicResource ThemeSurface0}" Margin="12,0,12,6"/>
                        <ItemsControl x:Name="ClusterList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ClusterItem}"
                                            MouseLeftButtonDown="OnClusterClick"
                                            x:Name="ClusterBorder">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding VmCount}"
                                                       Foreground="{DynamicResource ThemeOverlay0}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Visibility="{Binding VmCountVisibility}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding StatusColor}"/>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{Binding NameColor}"
                                                           FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Divider -->
            <Border Grid.Column="1" Background="{DynamicResource ThemeSurface0}"/>

            <!-- Content area -->
            <DockPanel Grid.Column="2">
                <!-- Bottom bar -->
                <Border DockPanel.Dock="Bottom" Padding="16,0,16,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="1"
                                Background="{DynamicResource ThemeSurface0}" Margin="0,0,0,12"/>

                        <Button DockPanel.Dock="Right" Content="  Launch SPICE  "
                                Style="{StaticResource AccentButton}" Padding="16,8"
                                Click="OnLaunchSpice"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content=" Start " Style="{StaticResource FlatButton}"
                                    Foreground="{DynamicResource ThemeGreen}" Padding="10,8"
                                    Click="OnStartVm" Margin="0,0,4,0"/>
                            <Button Content=" Shutdown " Style="{StaticResource FlatButton}"
                                    Foreground="{DynamicResource ThemeYellow}" Padding="10,8"
                                    Click="OnShutdownVm" Margin="0,0,4,0"/>
                            <Button Content=" Reboot " Style="{StaticResource FlatButton}"
                                    Foreground="{DynamicResource ThemePeach}" Padding="10,8"
                                    Click="OnRebootVm" Margin="0,0,4,0"/>
                            <Button Content=" Force Stop " Style="{StaticResource FlatButton}"
                                    Foreground="{DynamicResource ThemeRed}" Padding="10,8"
                                    Click="OnForceStopVm" Margin="0,0,4,0"/>
                            <Button Content=" Snapshots " Style="{StaticResource FlatButton}"
                                    Foreground="{DynamicResource ThemeLavender}" Padding="10,8"
                                    Click="OnSnapshots" Margin="0,0,4,0"/>
                            <Button Content=" Quick Rollback " Style="{StaticResource FlatButton}"
                                    Foreground="{DynamicResource ThemePeach}" Padding="10,8"
                                    Click="OnQuickRollback" Margin="0,0,4,0"/>
                            <Button Content=" Notes &#x2699; " Style="{StaticResource FlatButton}"
                                    Foreground="{DynamicResource ThemeTeal}" Padding="10,8"
                                    Click="OnManageNotes" Margin="0,0,4,0"/>
                            <Button x:Name="ClearAllFiltersBtn" Content=" Clear All Filters " Style="{StaticResource FlatButton}"
                                    Foreground="{DynamicResource ThemeRed}" Padding="10,8"
                                    Click="OnClearAllFilters" Margin="0,0,4,0"
                                    Visibility="Collapsed"/>

                            <TextBlock x:Name="CheckCountLabel" Foreground="{DynamicResource ThemeSapphire}"
                                       FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Toolbar + VM Table -->
                <DockPanel Margin="16,14,16,0">
                    <!-- Toolbar -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Refresh"
                                Style="{StaticResource FlatButton}" FontSize="11"
                                Click="OnRefresh"/>
                        <TextBlock x:Name="StatusLabel" Text="Select a cluster to view VMs"
                                   Foreground="{DynamicResource ThemeOverlay0}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- VM DataGrid -->
                    <DataGrid x:Name="VmGrid" AutoGenerateColumns="False"
                              IsReadOnly="False" SelectionMode="Extended"
                              CanUserSortColumns="True" CanUserResizeColumns="True"
                              CanUserReorderColumns="True"
                              CanUserAddRows="False"
                              Background="{DynamicResource ThemeSurface0}"
                              Foreground="{DynamicResource ThemeText}"
                              BorderThickness="0" GridLinesVisibility="None"
                              RowHeight="34" HeadersVisibility="Column"
                              FontFamily="Segoe UI" FontSize="12"
                              SelectionChanged="OnVmSelectionChanged">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurface1}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeSubtext0}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurface2}"/>
                                <Setter Property="ToolTip" Value="Right-click to filter"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurface0}"/>
                                <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeSurface1}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeSurface1}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="40">
                                <DataGridCheckBoxColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="SelectAllCheckBox"
                                                  Click="OnSelectAllCheckBox"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridCheckBoxColumn.HeaderTemplate>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Binding="{Binding VmId}" Header="VMID" Width="60" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="NAME" Width="180" SortMemberPath="Name" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   Foreground="{Binding NameForeground}"
                                                   MouseLeftButtonDown="OnNameDoubleClick" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding IpAddress}" Header="IP" Width="115" IsReadOnly="True"/>
                            <DataGridTextColumn Binding="{Binding Node}" Header="NODE" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Binding="{Binding Pool}" Header="POOL" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Binding="{Binding SnapCount}" Header="SNAPS" Width="55" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="STATUS" Width="95" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadge}"
                                                Background="{Binding StatusBackground}">
                                            <TextBlock Text="{Binding Status}" FontWeight="{Binding StatusFontWeight}"
                                                       Foreground="{Binding StatusForeground}"
                                                       HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="NOTES" Width="*" SortMemberPath="Notes">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Notes}" VerticalAlignment="Center"
                                                   Foreground="{Binding RowForeground}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox x:Name="NotesCombo" IsEditable="True"
                                                  Text="{Binding Notes, UpdateSourceTrigger=Explicit}"
                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=NoteOptionsList}"
                                                  Loaded="OnNotesComboLoaded"
                                                  LostFocus="OnNotesComboLostFocus"
                                                  Background="{DynamicResource ThemeSurface0}"
                                                  Foreground="{DynamicResource ThemeText}"
                                                  ItemContainerStyle="{StaticResource ThemedComboBoxItem}"
                                                  BorderThickness="0" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
