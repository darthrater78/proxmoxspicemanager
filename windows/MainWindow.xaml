<Window x:Class="ProxmoxSpiceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProxmoxSpiceManager"
        Title="Proxmox SPICE Manager" Height="760" Width="1280"
        MinHeight="600" MinWidth="1000"
        Background="{DynamicResource ThemeCrust}"
        TextElement.FontFamily="Segoe UI" TextElement.FontSize="13"
        Icon="..\icon.ico"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowKeyDown">

    <Window.Resources>
        <local:NodeSummaryConverter x:Key="NodeSummary"/>
        <FontFamily x:Key="Mono">Cascadia Code, Consolas</FontFamily>

        <!-- Stroked 16px line icon -->
        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource ThemeSubtext1}"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Geometry x:Key="IconMonitor">M3,4 H13 V10 H3 Z M6,13 H10 M8,10 V13</Geometry>
        <Geometry x:Key="IconPlay">M5,3 L12.5,8 L5,13 Z</Geometry>
        <Geometry x:Key="IconPower">M8,2 V7.5 M4.6,4.4 A5,5 0 1 0 11.4,4.4</Geometry>
        <Geometry x:Key="IconRefresh">M13,8 A5,5 0 1 1 11.5,4.5 M11.5,1.8 V4.6 H8.7</Geometry>
        <Geometry x:Key="IconCamera">M2.5,5 H5 L6.5,3 H9.5 L11,5 H13.5 V12.5 H2.5 Z M8,6.8 A2.2,2.2 0 1 0 8,11.2 A2.2,2.2 0 1 0 8,6.8</Geometry>
        <Geometry x:Key="IconUndo">M3,6.5 H10 A3,3 0 0 1 10,12.5 H6 M5.5,4 L3,6.5 L5.5,9</Geometry>
        <Geometry x:Key="IconStop">M4,4 H12 V12 H4 Z</Geometry>
        <Geometry x:Key="IconPlus">M8,3 V13 M3,8 H13</Geometry>
        <Geometry x:Key="IconGear">M8,5.8 A2.2,2.2 0 1 0 8,10.2 A2.2,2.2 0 1 0 8,5.8 M8,1.8 V3.4 M8,12.6 V14.2 M1.8,8 H3.4 M12.6,8 H14.2 M3.6,3.6 L4.7,4.7 M11.3,11.3 L12.4,12.4 M3.6,12.4 L4.7,11.3 M11.3,4.7 L12.4,3.6</Geometry>
        <Geometry x:Key="IconSearch">M7,2.5 A4.5,4.5 0 1 0 7,11.5 A4.5,4.5 0 1 0 7,2.5 M10.3,10.3 L13.5,13.5</Geometry>
        <Geometry x:Key="IconChevron">M4.5,6.5 L8,10 L11.5,6.5</Geometry>
        <Geometry x:Key="IconCheck">M3.5,8.5 L6.5,11.5 L12.5,4.5</Geometry>

        <!-- Key cap, e.g. "F5" -->
        <Style x:Key="Key" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurface2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeOverlay1}"/>
        </Style>

        <!-- Bordered neutral button -->
        <Style x:Key="CmdButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurface0}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurface1}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurface1}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurface2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled accent button -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccent}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless row button: sidebar entries and popup menu items -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurface0}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- All / Running / Stopped chips -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="14" Padding="12,5" BorderThickness="1"
                                Background="{DynamicResource ThemeSurface0}" BorderBrush="{DynamicResource ThemeSurface1}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurface1}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="{DynamicResource ThemeSurface1}" Margin="1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeMantle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurface1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSubtext0}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ───────────────────────────────────────────────── -->
        <DockPanel Grid.Column="0" Margin="12,14,8,10">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,22">
                <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource ThemeAccent}">
                    <Path Data="{StaticResource IconMonitor}" Style="{StaticResource Glyph}" Stroke="{DynamicResource ThemeOnAccent}" StrokeThickness="1.6" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SPICE Manager" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
                    <TextBlock x:Name="VersionText" Text="for Proxmox VE" FontSize="11" Foreground="{DynamicResource ThemeSubtext0}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <Border Height="1" Background="{DynamicResource ThemeSurface1}" Margin="8,0,8,6"/>
                <Button Style="{StaticResource NavButton}" Click="OnAddCluster">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource IconPlus}"/>
                        <TextBlock Text="Add cluster" Margin="10,0,0,0"/>
                    </StackPanel>
                </Button>
                <DockPanel>
                    <!-- Appearance quick switch: current accent over current theme -->
                    <Button x:Name="AppearanceBtn" DockPanel.Dock="Right" Style="{StaticResource CmdButton}" Padding="8,5"
                            Margin="4,0,0,0" ToolTip="Appearance" Click="OnOpenAppearance">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource ThemeAccent}"/>
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource ThemeBase}" Stroke="{DynamicResource ThemeSurface2}" Margin="-3,0,0,0"/>
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource IconChevron}" Width="12" Margin="4,0,0,0" StrokeThickness="1.3"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsBtn" Style="{StaticResource NavButton}" Click="OnOpenSettings">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource IconGear}"/>
                            <TextBlock Text="Settings" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </StackPanel>

            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Clusters" Style="{StaticResource SectionLabel}" Margin="10,0,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ClusterList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" CornerRadius="6" Padding="10,9" Margin="0,1" Background="Transparent" Cursor="Hand"
                                        MouseLeftButtonDown="OnClusterClick" ToolTip="Double-click to edit">
                                    <Grid>
                                        <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource ThemeAccent}"
                                                HorizontalAlignment="Left" Margin="-10,0,0,0" Visibility="Collapsed"/>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource ThemeSubtext0}"/>
                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeMantle}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeSurface0}"/>
                                        <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>

        <!-- ── Content layer ─────────────────────────────────────────── -->
        <Border Grid.Column="1" Margin="0,8,8,8" CornerRadius="8" Background="{DynamicResource ThemeBase}"
                BorderBrush="{DynamicResource ThemeSurface0}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="24,20,16,12">
                    <!-- Header -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,8,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="210" Height="32" CornerRadius="6" Background="{DynamicResource ThemeMantle}"
                                    BorderBrush="{DynamicResource ThemeSurface1}" BorderThickness="1" Margin="0,0,8,0">
                                <DockPanel Margin="10,0,8,0">
                                    <Border x:Name="SearchKey" DockPanel.Dock="Right" Style="{StaticResource Key}"><TextBlock Text="/" Style="{StaticResource KeyText}"/></Border>
                                    <Path DockPanel.Dock="Left" Style="{StaticResource Glyph}" Stroke="{DynamicResource ThemeOverlay1}" Data="{StaticResource IconSearch}"/>
                                    <Grid Margin="8,0,4,0">
                                        <TextBlock x:Name="SearchHint" Text="Search VMs" Foreground="{DynamicResource ThemeOverlay1}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource ThemeText}" CaretBrush="{DynamicResource ThemeText}"
                                                 TextChanged="OnSearchChanged" GotKeyboardFocus="OnSearchFocus" LostKeyboardFocus="OnSearchFocus"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Button Style="{StaticResource CmdButton}" Click="OnRefresh" ToolTip="Refresh (F5)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource IconRefresh}"/>
                                    <TextBlock Text="Refresh" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource Key}"><TextBlock Text="F5" Style="{StaticResource KeyText}"/></Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="ClusterTitle" Text="No cluster" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="StatusLabel" Text="Add a cluster to get started" Foreground="{DynamicResource ThemeSubtext0}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Filter chips; grouping and sort on the right -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,8,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton x:Name="GroupToggle" Click="OnGroupToggle" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                      Margin="0,0,6,0" ToolTip="Group VMs under the node they run on">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="14" Padding="12,5" BorderThickness="1"
                                            Background="{DynamicResource ThemeSurface0}" BorderBrush="{DynamicResource ThemeSurface1}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="Tick" Style="{StaticResource Glyph}" Data="{StaticResource IconCheck}" Width="14"
                                                  Stroke="{DynamicResource ThemeText}" Margin="0,0,6,0" Visibility="Collapsed"/>
                                            <TextBlock Text="Group by node" Foreground="{DynamicResource ThemeText}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurface1}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurface1}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeSurface2}"/>
                                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Button x:Name="SortBtn" Style="{StaticResource CmdButton}" Padding="12,5" Click="OnSortMenu" ToolTip="Sort VMs">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SortText" Text="Sort: ID ▲"/>
                                <Path Style="{StaticResource Glyph}" Data="{StaticResource IconChevron}" Width="12" Margin="6,0,0,0" StrokeThickness="1.3"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FilterAll" Style="{StaticResource Chip}" GroupName="VmFilter" IsChecked="True" Checked="OnFilterChanged" Content="All"/>
                        <RadioButton x:Name="FilterRunning" Style="{StaticResource Chip}" GroupName="VmFilter" Checked="OnFilterChanged" Content="Running"/>
                        <RadioButton x:Name="FilterStopped" Style="{StaticResource Chip}" GroupName="VmFilter" Checked="OnFilterChanged" Content="Stopped"/>
                    </StackPanel>
                    </DockPanel>

                    <Grid>
                        <TextBlock x:Name="EmptyText" Text="No VMs to show" Foreground="{DynamicResource ThemeOverlay1}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                        <!-- VM list, grouped by node -->
                        <ListBox x:Name="VmList" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"
                                 SelectionChanged="OnVmSelectionChanged" MouseDoubleClick="OnVmDoubleClick"
                                 FocusVisualStyle="{x:Null}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter Margin="0,0,0,4"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="4,12,4,6">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Items, Converter={StaticResource NodeSummary}}"
                                                           FontSize="12" Foreground="{DynamicResource ThemeSubtext0}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeSubtext1}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="6" Background="{DynamicResource ThemeSurface0}"
                                            BorderBrush="{DynamicResource ThemeSurface0}" BorderThickness="1" Padding="10,0" Height="46">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*" MinWidth="120"/>
                                                <ColumnDefinition Width="118"/>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="22" CornerRadius="4" Background="{DynamicResource ThemeSurface1}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding OsLabel}">
                                                <TextBlock Text="{Binding OsBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeSubtext1}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="Name" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource ThemeSubtext0}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding IpOrDash}" FontFamily="{StaticResource Mono}" FontSize="12"
                                                       Foreground="{DynamicResource ThemeSubtext1}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Snapshots">
                                                <Path Style="{StaticResource Glyph}" Stroke="{DynamicResource ThemeOverlay1}" Data="{StaticResource IconCamera}"/>
                                                <TextBlock Text="{Binding SnapCount}" Foreground="{DynamicResource ThemeSubtext0}" Margin="5,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource ThemeGreen}"/>
                                                <TextBlock x:Name="State" Text="{Binding StatusText}" Foreground="{DynamicResource ThemeGreen}" Margin="7,0,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="ConnectBtn" Grid.Column="5" Width="98" VerticalAlignment="Center" Style="{StaticResource AccentButton}" Padding="0,6"
                                                    Click="OnRowConnect" ToolTip="Open SPICE console">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource IconMonitor}" Stroke="{DynamicResource ThemeOnAccent}" StrokeThickness="1.5"/>
                                                    <TextBlock Text="Connect" Margin="7,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="StartBtn" Grid.Column="5" Width="98" VerticalAlignment="Center" Style="{StaticResource CmdButton}" Padding="0,5"
                                                    HorizontalContentAlignment="Center" Click="OnRowStart" Visibility="Collapsed" ToolTip="Start this VM">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource IconPlay}"/>
                                                    <TextBlock Text="Start" Margin="7,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ThemeOverlay0}"/>
                                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource ThemeOverlay1}"/>
                                            <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource ThemeSubtext0}"/>
                                            <Setter TargetName="ConnectBtn" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="StartBtn" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ThemeSurface2}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeSurface1}"/>
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>

                <!-- ── Inspector ──────────────────────────────────────── -->
                <Border Grid.Column="1" Background="{DynamicResource ThemeMantle}" BorderBrush="{DynamicResource ThemeSurface0}"
                        BorderThickness="1,0,0,0" CornerRadius="0,8,8,0">
                    <Grid Margin="20,22,20,18">
                        <TextBlock x:Name="InspectorEmpty" Text="Select a VM to see its details and actions." TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThemeOverlay1}" VerticalAlignment="Center" TextAlignment="Center"/>
                        <DockPanel x:Name="InspectorPanel" Visibility="Collapsed">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="InspectorCaption" Text="Selected" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="InspectorName" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Foreground="{DynamicResource ThemeSubtext0}">
                                    <Run x:Name="InspectorOs"/><Run x:Name="InspectorSep" Text=" · "/><Run x:Name="InspectorState"/>
                                </TextBlock>

                                <Button x:Name="OpenConsoleBtn" Style="{StaticResource AccentButton}" Padding="14,9" Margin="0,16,0,0"
                                        HorizontalContentAlignment="Stretch" Click="OnLaunchSpice">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Key}" BorderBrush="{DynamicResource ThemeOnAccent}" Opacity="0.7">
                                            <TextBlock Text="Enter" Style="{StaticResource KeyText}" Foreground="{DynamicResource ThemeOnAccent}"/>
                                        </Border>
                                        <Path Style="{StaticResource Glyph}" Data="{StaticResource IconMonitor}" Stroke="{DynamicResource ThemeOnAccent}" StrokeThickness="1.5"/>
                                        <TextBlock x:Name="OpenConsoleText" Text="Open SPICE console" Margin="8,0,0,0"/>
                                    </DockPanel>
                                </Button>

                                <Grid x:Name="InspectorDetails" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="VM ID" Foreground="{DynamicResource ThemeSubtext0}" Margin="0,0,0,7"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailId" Foreground="{DynamicResource ThemeText}"/>
                                    <TextBlock Grid.Row="1" Text="Address" Foreground="{DynamicResource ThemeSubtext0}" Margin="0,0,0,7"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailIp" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource ThemeText}"/>
                                    <TextBlock Grid.Row="2" Text="Node" Foreground="{DynamicResource ThemeSubtext0}" Margin="0,0,0,7"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailNode" Foreground="{DynamicResource ThemeText}"/>
                                    <TextBlock Grid.Row="3" Text="Pool" Foreground="{DynamicResource ThemeSubtext0}" Margin="0,0,0,7"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailPool" Foreground="{DynamicResource ThemeText}"/>
                                    <TextBlock Grid.Row="4" Text="Notes" Foreground="{DynamicResource ThemeSubtext0}" VerticalAlignment="Center"/>
                                    <Border Grid.Row="4" Grid.Column="1" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ThemeSurface1}"
                                            Background="{DynamicResource ThemeBase}">
                                        <DockPanel>
                                            <Button x:Name="NotesMenuBtn" DockPanel.Dock="Right" Style="{StaticResource NavButton}" Padding="4,3"
                                                    Margin="1" ToolTip="Saved notes" Click="OnNotesMenu">
                                                <Path Style="{StaticResource Glyph}" Data="{StaticResource IconChevron}"/>
                                            </Button>
                                            <TextBox x:Name="NotesBox" Background="Transparent" BorderThickness="0" Padding="6,4"
                                                     VerticalContentAlignment="Center"
                                                     Foreground="{DynamicResource ThemeText}" CaretBrush="{DynamicResource ThemeText}"
                                                     LostKeyboardFocus="OnNotesBoxCommit" KeyDown="OnNotesBoxKey"/>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Actions" Style="{StaticResource SectionLabel}" Margin="0,22,0,8"/>
                                <Button Style="{StaticResource CmdButton}" Margin="0,0,0,5" HorizontalContentAlignment="Stretch" Click="OnStartVm">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Key}"><TextBlock Text="S" Style="{StaticResource KeyText}"/></Border>
                                        <Path Style="{StaticResource Glyph}" Data="{StaticResource IconPlay}"/>
                                        <TextBlock Text="Start" Margin="8,0,0,0"/>
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource CmdButton}" Margin="0,0,0,5" HorizontalContentAlignment="Stretch" Click="OnShutdownVm">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Key}"><TextBlock Text="Shift+S" Style="{StaticResource KeyText}"/></Border>
                                        <Path Style="{StaticResource Glyph}" Data="{StaticResource IconPower}"/>
                                        <TextBlock Text="Shut down" Margin="8,0,0,0"/>
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource CmdButton}" Margin="0,0,0,5" HorizontalContentAlignment="Stretch" Click="OnRebootVm">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Key}"><TextBlock Text="R" Style="{StaticResource KeyText}"/></Border>
                                        <Path Style="{StaticResource Glyph}" Data="{StaticResource IconRefresh}"/>
                                        <TextBlock Text="Reboot" Margin="8,0,0,0"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="SnapshotsBtn" Style="{StaticResource CmdButton}" Margin="0,0,0,5" HorizontalContentAlignment="Stretch" Click="OnSnapshots">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Key}"><TextBlock Text="P" Style="{StaticResource KeyText}"/></Border>
                                        <Path Style="{StaticResource Glyph}" Data="{StaticResource IconCamera}"/>
                                        <TextBlock Text="Snapshots" Margin="8,0,0,0"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="RollbackBtn" Style="{StaticResource CmdButton}" HorizontalContentAlignment="Stretch" Click="OnQuickRollback"
                                        ToolTip="Roll back to the most recent snapshot">
                                    <DockPanel>
                                        <Path Style="{StaticResource Glyph}" Data="{StaticResource IconUndo}"/>
                                        <TextBlock Text="Roll back to latest snapshot" Margin="8,0,0,0"/>
                                    </DockPanel>
                                </Button>
                            </StackPanel>

                            <Button DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Style="{StaticResource CmdButton}"
                                    HorizontalContentAlignment="Stretch" Click="OnForceStopVm">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Key}" BorderBrush="{DynamicResource ThemeRed}" Opacity="0.8">
                                        <TextBlock Text="Ctrl+." Style="{StaticResource KeyText}" Foreground="{DynamicResource ThemeRed}"/>
                                    </Border>
                                    <Path Style="{StaticResource Glyph}" Stroke="{DynamicResource ThemeRed}" Data="{StaticResource IconStop}"/>
                                    <TextBlock Text="Force stop" Margin="8,0,0,0" Foreground="{DynamicResource ThemeRed}"/>
                                </DockPanel>
                            </Button>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ── Appearance flyout ─────────────────────────────────────── -->
        <Popup x:Name="AppearancePopup" PlacementTarget="{Binding ElementName=AppearanceBtn}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PopupCard}" Width="316" Padding="14,14,14,12">
                <StackPanel>
                    <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
                    <TextBlock Text="Theme" Style="{StaticResource SectionLabel}" Margin="0,12,0,6"/>
                    <ItemsControl x:Name="ThemeChoices">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="Row" Style="{StaticResource NavButton}" Padding="6,5" Margin="0,1" Click="OnThemeChoice">
                                    <DockPanel>
                                        <Path x:Name="Check" DockPanel.Dock="Right" Style="{StaticResource Glyph}" Stroke="{DynamicResource ThemeAccent}"
                                              StrokeThickness="1.8" Data="{StaticResource IconCheck}" Visibility="Hidden"/>
                                        <!-- Miniature of the theme: page, card, a line of text, the accent -->
                                        <Border Width="46" Height="28" CornerRadius="4" Background="{Binding Crust}" BorderBrush="{Binding Surface}" BorderThickness="1" ClipToBounds="True">
                                            <Canvas>
                                                <Border Canvas.Left="12" Canvas.Top="4" Width="30" Height="18" CornerRadius="2" Background="{Binding Base}"/>
                                                <Border Canvas.Left="15" Canvas.Top="8" Width="16" Height="3" CornerRadius="1" Background="{Binding Text}"/>
                                                <Border Canvas.Left="15" Canvas.Top="14" Width="10" Height="4" CornerRadius="1" Background="{Binding Accent}"/>
                                                <Border Canvas.Left="3" Canvas.Top="5" Width="6" Height="2" Background="{Binding Surface}"/>
                                                <Border Canvas.Left="3" Canvas.Top="9" Width="6" Height="2" Background="{Binding Surface}"/>
                                            </Canvas>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </DockPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeSurface0}"/>
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,14,0,8">
                        <TextBlock x:Name="AccentName" DockPanel.Dock="Right" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Accent" Style="{StaticResource SectionLabel}"/>
                    </DockPanel>
                    <ItemsControl x:Name="AccentChoices">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnAccentChoice" ToolTip="{Binding Name}" Cursor="Hand" Margin="0,0,5,0" FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Width="34" Height="34" Background="Transparent">
                                                <Ellipse x:Name="Ring" Width="32" Height="32" StrokeThickness="2" Stroke="{DynamicResource ThemeText}" Visibility="Hidden"/>
                                                <Ellipse x:Name="Swatch" Width="24" Height="24" Fill="{Binding Brush}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Swatch" Property="Width" Value="27"/>
                                                    <Setter TargetName="Swatch" Property="Height" Value="27"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
