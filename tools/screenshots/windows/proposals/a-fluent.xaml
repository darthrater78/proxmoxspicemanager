<!-- Direction A, "Fluent": a native Windows 11 feel. Layered dark surfaces, 8px radii,
     Proxmox-orange accent, a Connect button on every running VM's row. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="1280" Height="760" TextElement.FontFamily="Segoe UI" TextElement.FontSize="13">
    <Grid.Resources>
        <SolidColorBrush x:Key="Accent" Color="#F28C28"/>
        <SolidColorBrush x:Key="Ink" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="Sub" Color="#A8A8A8"/>
        <SolidColorBrush x:Key="Card" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="Line" Color="#3A3A3A"/>
        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Stroke" Value="#D6D6D6"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
        </Style>
        <Style x:Key="CmdButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#2F2F2F" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="6" Padding="12,7">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>
    <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#232323" Offset="0"/>
            <GradientStop Color="#1C1C1C" Offset="1"/>
        </LinearGradientBrush>
    </Grid.Background>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Navigation pane -->
    <DockPanel Grid.Column="0" Margin="12,14,8,12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,22">
            <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Accent}">
                <Path Data="M3,4 H13 V10 H3 Z M6,13 H10 M8,10 V13" Stroke="#1A1A1A" StrokeThickness="1.6" Width="16" Height="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="SPICE Manager" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="for Proxmox VE · v3.0.0" FontSize="11" Foreground="{StaticResource Sub}"/>
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <Border Height="1" Background="{StaticResource Line}" Margin="8,0,8,8"/>
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <Path Style="{StaticResource Glyph}" Data="M8,3 V13 M3,8 H13"/>
                <TextBlock Text="Add cluster" Margin="10,0,0,0" Foreground="{StaticResource Ink}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <Path Style="{StaticResource Glyph}" Data="M8,2.5 A5.5,5.5 0 1 0 8,13.5 A5.5,5.5 0 1 0 8,2.5 M8,6 V8.5 M8,10.8 V11"/>
                <TextBlock Text="Settings" Margin="10,0,0,0" Foreground="{StaticResource Ink}"/>
            </StackPanel>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Clusters" FontSize="12" Foreground="{StaticResource Sub}" Margin="10,0,0,6"/>
            <ItemsControl ItemsSource="{Binding Clusters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" CornerRadius="6" Padding="10,9" Margin="0,1">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource Accent}" HorizontalAlignment="Left" Margin="-10,0,0,0" Visibility="Collapsed"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource Sub}" FontSize="12"/>
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#6CCB5F" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#2E2E2E"/>
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Online}" Value="False">
                                <Setter TargetName="Dot" Property="Fill" Value="#6B6B6B"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DockPanel>

    <!-- Content: rounded layer, like a Windows 11 page over Mica -->
    <Border Grid.Column="1" Margin="0,8,8,8" CornerRadius="8" Background="#262626" BorderBrush="#333333" BorderThickness="1">
        <DockPanel Margin="24,20,24,16">
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="240" Height="32" CornerRadius="6" Background="#1F1F1F" BorderBrush="#3D3D3D" BorderThickness="1" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <Path Style="{StaticResource Glyph}" Stroke="#9A9A9A" Data="M7,2.5 A4.5,4.5 0 1 0 7,11.5 A4.5,4.5 0 1 0 7,2.5 M10.3,10.3 L13.5,13.5"/>
                            <TextBlock Text="Search VMs" Foreground="#8A8A8A" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource CmdButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Glyph}" Data="M13,8 A5,5 0 1 1 11.5,4.5 M11.5,1.8 V4.6 H8.7"/>
                            <TextBlock Text="Refresh" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Homelab" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBlock Foreground="{StaticResource Sub}" Margin="0,2,0,0">
                        <Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=" SPICE VMs · 3 nodes · homelab.example.com"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Filter chips -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <Border CornerRadius="14" Background="{StaticResource Accent}" Padding="12,5" Margin="0,0,6,0">
                    <TextBlock Foreground="#1A1A1A" FontWeight="SemiBold"><Run Text="All  "/><Run Text="{Binding TotalCount, Mode=OneWay}"/></TextBlock>
                </Border>
                <Border CornerRadius="14" Background="#2F2F2F" BorderBrush="#3D3D3D" BorderThickness="1" Padding="12,5" Margin="0,0,6,0">
                    <TextBlock Foreground="{StaticResource Ink}"><Run Text="Running  "/><Run Text="{Binding RunningCount, Mode=OneWay}"/></TextBlock>
                </Border>
                <Border CornerRadius="14" Background="#2F2F2F" BorderBrush="#3D3D3D" BorderThickness="1" Padding="12,5">
                    <TextBlock Foreground="{StaticResource Ink}"><Run Text="Stopped  "/><Run Text="{Binding StoppedCount, Mode=OneWay}"/></TextBlock>
                </Border>
            </StackPanel>

            <!-- Selection command bar -->
            <Border DockPanel.Dock="Bottom" CornerRadius="8" Background="#2F2F2F" BorderBrush="#3D3D3D" BorderThickness="1" Padding="14,8" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource Sub}" Margin="0,0,16,0">
                        <Run Text="Selected: "/><Run Text="{Binding SelectedVm.Name, Mode=OneWay}" Foreground="#F3F3F3" FontWeight="SemiBold"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource CmdButton}" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Data="M5,3 L12.5,8 L5,13 Z"/><TextBlock Text="Start" Margin="7,0,0,0"/></StackPanel></Button>
                        <Button Style="{StaticResource CmdButton}" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Data="M8,2 V7.5 M4.6,4.4 A5,5 0 1 0 11.4,4.4"/><TextBlock Text="Shut down" Margin="7,0,0,0"/></StackPanel></Button>
                        <Button Style="{StaticResource CmdButton}" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Data="M13,8 A5,5 0 1 1 11.5,4.5 M11.5,1.8 V4.6 H8.7"/><TextBlock Text="Reboot" Margin="7,0,0,0"/></StackPanel></Button>
                        <Button Style="{StaticResource CmdButton}" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Data="M2.5,5 H5 L6.5,3 H9.5 L11,5 H13.5 V12.5 H2.5 Z M8,6.8 A2.2,2.2 0 1 0 8,11.2 A2.2,2.2 0 1 0 8,6.8"/><TextBlock Text="Snapshots" Margin="7,0,0,0"/></StackPanel></Button>
                        <Button Style="{StaticResource CmdButton}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Stroke="#FF9C8F" Data="M4,4 H12 V12 H4 Z"/><TextBlock Text="Force stop" Margin="7,0,0,0" Foreground="#FF9C8F"/></StackPanel></Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- VM list -->
            <ItemsControl ItemsSource="{Binding Vms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" CornerRadius="6" Background="{StaticResource Card}" BorderBrush="#343434" BorderThickness="1" Padding="12,0" Margin="0,0,0,4" Height="48">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="22" CornerRadius="4" Background="#383838" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OsBadge}" FontSize="10" FontWeight="Bold" Foreground="#CFCFCF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="Name" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{StaticResource Sub}"/>
                                        <TextBlock x:Name="NoteText" FontSize="11" Foreground="{StaticResource Sub}"><Run Text=" · "/><Run Text="{Binding Notes, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding IpOrDash}" FontFamily="Cascadia Code" FontSize="12" Foreground="#CFCFCF" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Node}" Foreground="{StaticResource Sub}"/>
                                    <TextBlock x:Name="PoolText" Foreground="{StaticResource Sub}"><Run Text="  ·  "/><Run Text="{Binding Pool, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource Glyph}" Stroke="#9A9A9A" Data="M2.5,5 H5 L6.5,3 H9.5 L11,5 H13.5 V12.5 H2.5 Z M8,6.8 A2.2,2.2 0 1 0 8,11.2 A2.2,2.2 0 1 0 8,6.8"/>
                                    <TextBlock Text="{Binding Snaps}" Foreground="{StaticResource Sub}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#6CCB5F"/>
                                    <TextBlock x:Name="State" Text="{Binding Status}" Foreground="#9FDD94" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Border x:Name="Connect" Grid.Column="6" CornerRadius="6" Background="{StaticResource Accent}" Padding="14,6" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M3,4 H13 V10 H3 Z M6,13 H10 M8,10 V13" Stroke="#1A1A1A" StrokeThickness="1.5" Width="16" Height="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock Text="Connect" Foreground="#1A1A1A" FontWeight="SemiBold" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StartBtn" Grid.Column="6" CornerRadius="6" Background="#333333" BorderBrush="#444444" BorderThickness="1" Padding="14,6" VerticalAlignment="Center" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Glyph}" Data="M5,3 L12.5,8 L5,13 Z"/>
                                        <TextBlock Text="Start" Foreground="#E6E6E6" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Running}" Value="False">
                                <Setter TargetName="Dot" Property="Fill" Value="#6B6B6B"/>
                                <Setter TargetName="State" Property="Foreground" Value="#8A8A8A"/>
                                <Setter TargetName="Name" Property="Foreground" Value="#B0B0B0"/>
                                <Setter TargetName="Connect" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="StartBtn" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasNotes}" Value="False">
                                <Setter TargetName="NoteText" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasPool}" Value="False">
                                <Setter TargetName="PoolText" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#353535"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#F28C28"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Grid>
