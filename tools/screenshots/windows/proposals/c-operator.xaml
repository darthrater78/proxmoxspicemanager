<!-- Direction C, "Operator": dense and keyboard-first. Charcoal with an amber accent,
     monospace for data, VMs grouped by node, every action shown with its key. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="1280" Height="760" Background="#141414" TextElement.FontFamily="Segoe UI" TextElement.FontSize="13">
    <Grid.Resources>
        <SolidColorBrush x:Key="Amber" Color="#FFB020"/>
        <SolidColorBrush x:Key="Ink" Color="#E8E4DC"/>
        <SolidColorBrush x:Key="Sub" Color="#8C877E"/>
        <SolidColorBrush x:Key="Rule" Color="#262626"/>
        <FontFamily x:Key="Mono">Cascadia Code</FontFamily>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="40"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>

    <!-- Title strip -->
    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#0E0E0E" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
        <DockPanel Margin="16,0">
            <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Center">
                <Run Text="homelab.example.com:8006"/><Run Text="   TLS verified" Foreground="#7FD18B"/>
            </TextBlock>
            <TextBlock FontFamily="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource Ink}">
                <Run Text="spice" Foreground="#FFB020" FontWeight="Bold"/><Run Text="://" Foreground="#8C877E"/><Run Text="homelab"/><Run Text="  ▸  " Foreground="#8C877E"/><Run Text="3 nodes"/><Run Text="  ▸  " Foreground="#8C877E"/><Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=" vms"/>
            </TextBlock>
        </DockPanel>
    </Border>

    <!-- Clusters -->
    <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,1,0">
        <StackPanel Margin="0,14,0,0">
            <TextBlock Text="CLUSTERS" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Sub}" Margin="16,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Clusters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Padding="16,7">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontFamily="Cascadia Code" FontSize="12" Foreground="#8C877E"/>
                                <TextBlock x:Name="Mark" Text="○ " FontFamily="Cascadia Code" Foreground="#8C877E"/>
                                <TextBlock x:Name="Label" Text="{Binding Name}" Foreground="#E8E4DC"/>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#221D12"/>
                                <Setter TargetName="Mark" Property="Text" Value="● "/>
                                <Setter TargetName="Mark" Property="Foreground" Value="#FFB020"/>
                                <Setter TargetName="Label" Property="Foreground" Value="#FFB020"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Online}" Value="False">
                                <Setter TargetName="Label" Property="Foreground" Value="#6B665E"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>

    <!-- VM table, grouped by node -->
    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
        <Grid DockPanel.Dock="Top" Margin="20,4,16,6" TextElement.FontFamily="Cascadia Code" TextElement.FontSize="11" TextElement.Foreground="#8C877E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54"/><ColumnDefinition Width="60"/><ColumnDefinition Width="190"/><ColumnDefinition Width="130"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="STATE"/>
            <TextBlock Grid.Column="1" Text="VMID"/>
            <TextBlock Grid.Column="2" Text="NAME"/>
            <TextBlock Grid.Column="3" Text="ADDRESS"/>
            <TextBlock Grid.Column="4" Text="SNAP"/>
            <TextBlock Grid.Column="5" Text="NOTES"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,6">
                        <DockPanel Margin="20,8,16,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontFamily="Cascadia Code" FontSize="11" Foreground="#8C877E"/>
                            <TextBlock FontFamily="Cascadia Code" FontSize="12" Foreground="#FFB020"><Run Text="▾ "/><Run Text="{Binding Node, Mode=OneWay}"/></TextBlock>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Vms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Padding="20,6,16,6" BorderBrush="#1D1D1D" BorderThickness="0,0,0,1">
                                        <Grid TextElement.FontFamily="Cascadia Code" TextElement.FontSize="12.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54"/><ColumnDefinition Width="60"/><ColumnDefinition Width="190"/><ColumnDefinition Width="130"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="State" Grid.Column="0" Foreground="#7FD18B"><Run x:Name="Glyph" Text="● "/><Run Text="{Binding StatusShort, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding Id}" Foreground="#8C877E"/>
                                            <TextBlock x:Name="Name" Grid.Column="2" Text="{Binding Name}" Foreground="#E8E4DC"/>
                                            <TextBlock Grid.Column="3" Text="{Binding IpOrDash}" Foreground="#B8B2A7"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Snaps}" Foreground="#8C877E"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Notes}" FontFamily="Segoe UI" FontSize="12.5" Foreground="#B8B2A7"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Running}" Value="False">
                                            <Setter TargetName="State" Property="Foreground" Value="#6B665E"/>
                                            <Setter TargetName="Glyph" Property="Text" Value="○ "/>
                                            <Setter TargetName="Name" Property="Foreground" Value="#8C877E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Selected}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#2A2213"/>
                                            <Setter TargetName="Name" Property="Foreground" Value="#FFB020"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>

    <!-- Inspector for the selected VM -->
    <Border Grid.Row="1" Grid.Column="2" Background="#191919" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0" DataContext="{Binding SelectedVm}">
        <StackPanel Margin="20,18,20,0">
            <TextBlock Text="SELECTED" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Sub}"/>
            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,6,0,2"/>
            <TextBlock Text="{Binding OsLabel}" Foreground="{StaticResource Sub}"/>
            <Border Background="{StaticResource Amber}" CornerRadius="3" Padding="0,10" Margin="0,18,0,0">
                <DockPanel Margin="14,0">
                    <Border DockPanel.Dock="Right" BorderBrush="#5A3E00" BorderThickness="1" CornerRadius="3" Padding="6,1">
                        <TextBlock Text="Enter" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="#3A2800"/>
                    </Border>
                    <TextBlock Text="Open SPICE console" FontWeight="Bold" Foreground="#1A1200"/>
                </DockPanel>
            </Border>
            <Grid Margin="0,20,0,0" TextElement.FontFamily="Cascadia Code" TextElement.FontSize="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="vmid" Foreground="#8C877E" Margin="0,0,0,8"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Id}" Foreground="#E8E4DC"/>
                <TextBlock Grid.Row="1" Text="address" Foreground="#8C877E" Margin="0,0,0,8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IpOrDash}" Foreground="#E8E4DC"/>
                <TextBlock Grid.Row="2" Text="node" Foreground="#8C877E" Margin="0,0,0,8"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Node}" Foreground="#E8E4DC"/>
                <TextBlock Grid.Row="3" Text="pool" Foreground="#8C877E" Margin="0,0,0,8"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Pool}" Foreground="#E8E4DC"/>
                <TextBlock Grid.Row="4" Text="snaps" Foreground="#8C877E"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Snaps}" Foreground="#E8E4DC"/>
            </Grid>
            <TextBlock Text="NOTES" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Sub}" Margin="0,20,0,6"/>
            <Border Background="#141414" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="3" Padding="10,8">
                <TextBlock Text="{Binding Notes}" Foreground="{StaticResource Ink}"/>
            </Border>
        </StackPanel>
    </Border>

    <!-- Key hints -->
    <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#0E0E0E" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center" TextElement.FontFamily="Cascadia Code" TextElement.FontSize="12">
            <TextBlock Foreground="#8C877E" Margin="0,0,22,0"><Run Text="Enter" Foreground="#FFB020"/><Run Text=" console"/></TextBlock>
            <TextBlock Foreground="#8C877E" Margin="0,0,22,0"><Run Text="S" Foreground="#FFB020"/><Run Text=" start"/></TextBlock>
            <TextBlock Foreground="#8C877E" Margin="0,0,22,0"><Run Text="Shift+S" Foreground="#FFB020"/><Run Text=" shut down"/></TextBlock>
            <TextBlock Foreground="#8C877E" Margin="0,0,22,0"><Run Text="R" Foreground="#FFB020"/><Run Text=" reboot"/></TextBlock>
            <TextBlock Foreground="#8C877E" Margin="0,0,22,0"><Run Text="P" Foreground="#FFB020"/><Run Text=" snapshots"/></TextBlock>
            <TextBlock Foreground="#8C877E" Margin="0,0,22,0"><Run Text="/" Foreground="#FFB020"/><Run Text=" filter"/></TextBlock>
            <TextBlock Foreground="#8C877E" Margin="0,0,22,0"><Run Text="F5" Foreground="#FFB020"/><Run Text=" refresh"/></TextBlock>
            <TextBlock Foreground="#8C877E"><Run Text="Ctrl+." Foreground="#FFB020"/><Run Text=" force stop"/></TextBlock>
        </StackPanel>
    </Border>
</Grid>
